---
import { siteConfig } from "../../data/site";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section
  id="ubicacion"
  class="py-20 sm:py-32 border-b border-line bg-ink"
  aria-labelledby="location-heading"
>
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Details Column (Mobile Top, Desktop Left) -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div class="reveal mb-8">
          <SectionHeading
            eyebrow="Salón Boutique"
            title="Visítenos en Barrio Escalante"
            subtitle="Atención privada en un ambiente confidencial, diseñado para apreciar cada pieza con el tiempo y detalle que merece."
            align="left"
          />
        </div>

        <!-- Address & Contact Information in <address> -->
        <address class="reveal not-italic flex flex-col gap-6 text-sm text-muted font-sans border-t border-line/80 pt-6 mb-8">
          <!-- Physical Location -->
          <div class="flex items-start gap-3.5">
            <div class="w-9 h-9 rounded bg-surface-2 border border-line flex items-center justify-center text-gold flex-shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </div>
            <div>
              <strong class="font-medium text-text block mb-1">Dirección</strong>
              <p class="leading-relaxed">
                {siteConfig.address.street}, {siteConfig.address.neighborhood}<br />
                {siteConfig.address.city}, {siteConfig.address.state}, {siteConfig.address.country}
              </p>
            </div>
          </div>

          <!-- Schedule with <dl> -->
          <div class="flex items-start gap-3.5">
            <div class="w-9 h-9 rounded bg-surface-2 border border-line flex items-center justify-center text-gold flex-shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
            </div>
            <div class="w-full">
              <strong class="font-medium text-text block mb-1">Horario de Atención</strong>
              <dl class="space-y-1 text-xs">
                {
                  siteConfig.schedule.map((item) => (
                    <div class="flex items-center justify-between py-0.5 border-b border-line/40">
                      <dt class="text-muted">{item.days}</dt>
                      <dd class="text-text font-medium">{item.hours}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>

          <!-- Phone & Instagram Links -->
          <div class="flex items-start gap-3.5">
            <div class="w-9 h-9 rounded bg-surface-2 border border-line flex items-center justify-center text-gold flex-shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </div>
            <div class="flex flex-col gap-1">
              <strong class="font-medium text-text block">Canales Directos</strong>
              <div class="flex items-center gap-3">
                <a
                  href={`tel:${siteConfig.phone}`}
                  class="text-xs text-gold hover:text-gold-soft transition-colors focus-visible:outline-2 focus-visible:outline-gold"
                >
                  {siteConfig.phoneDisplay}
                </a>
                <span class="text-line">·</span>
                <a
                  href={siteConfig.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs text-muted hover:text-text transition-colors focus-visible:outline-2 focus-visible:outline-gold"
                >
                  Instagram {siteConfig.instagramHandle}
                </a>
              </div>
            </div>
          </div>
        </address>
      </div>

      <!-- Google Maps Iframe Column (Mobile Bottom, Desktop Right) -->
      <div class="lg:col-span-7 reveal">
        <div class="relative w-full aspect-[4/3] rounded-lg overflow-hidden border border-line bg-surface shadow-xl">
          <iframe
            src={siteConfig.address.googleMapsEmbedUrl}
            title="Mapa de ubicación de Cronos Relojería"
            class="w-full h-full border-0 grayscale invert contrast-125 opacity-80 hover:opacity-100 transition-opacity duration-300"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen=""
          ></iframe>
          <div class="absolute bottom-3 right-3 pointer-events-none bg-ink/90 backdrop-blur-md px-3 py-1.5 rounded border border-line text-[11px] text-muted">
            Barrio Escalante · San José
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
