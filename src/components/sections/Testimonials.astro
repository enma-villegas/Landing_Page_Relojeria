---
import { testimonials } from "../../data/testimonials";
import SectionHeading from "../ui/SectionHeading.astro";

const delayClasses = ["delay-0", "delay-[80ms]", "delay-[160ms]"];
---

<section
  id="testimonios"
  class="py-20 sm:py-32 border-b border-line bg-surface/30"
  aria-labelledby="testimonials-heading"
>
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <!-- Header -->
    <div class="reveal mb-14 sm:mb-16 text-center">
      <SectionHeading
        eyebrow="Clientes"
        title="La tranquilidad de elegir legitimidad"
        subtitle="Experiencias reales de coleccionistas y clientes que confiaron en nuestro protocolo de autenticidad y servicio."
        align="center"
      />
    </div>

    <!-- Testimonials Grid: 1 col móvil, 3 col desktop with 80ms stagger -->
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8"
      role="region"
      aria-label="Opiniones de clientes verificados"
    >
      {
        testimonials.map((item, index) => (
          <figure
            class={`reveal ${delayClasses[index] || "delay-0"} flex flex-col justify-between bg-surface border border-line rounded-lg p-6 sm:p-8 transition-all duration-300 hover:border-line/70 hover:shadow-lg`}
          >
            <!-- Quote Block -->
            <blockquote class="mb-8">
              <!-- Decorative quote icon -->
              <svg
                class="w-6 h-6 text-gold/40 mb-4"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
              <p class="text-sm sm:text-base text-text/90 font-sans leading-relaxed italic">
                "{item.quote}"
              </p>
            </blockquote>

            <!-- Figcaption with Author info & Verified Badge -->
            <figcaption class="flex items-center gap-3.5 pt-4 border-t border-line/60">
              <!-- Avatar circle with initials -->
              <div
                class="w-10 h-10 rounded-full bg-surface-2 border border-line flex items-center justify-center text-xs font-mono font-medium text-gold flex-shrink-0 select-none"
                aria-hidden="true"
              >
                {item.initials}
              </div>

              <!-- Author Details -->
              <div class="flex flex-col flex-grow min-w-0">
                <cite class="not-italic font-sans text-sm font-medium text-text line-clamp-1">
                  {item.name}
                </cite>
                <span class="text-xs text-muted line-clamp-1">
                  {item.city}, {item.country}
                </span>
              </div>

              <!-- Verified Badge -->
              {item.isVerified && (
                <div
                  class="flex items-center gap-1 px-2 py-0.5 rounded bg-gold/10 text-gold border border-gold/20 text-[10px] uppercase tracking-wider flex-shrink-0"
                  title="Compra verificada por Cronos Relojería"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="w-3 h-3 text-gold"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span class="hidden sm:inline">Verificado</span>
                </div>
              )}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
