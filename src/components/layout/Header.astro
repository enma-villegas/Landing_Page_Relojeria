---
import { siteConfig } from "../../data/site";
import { buildWhatsappUrl } from "../../utils/whatsapp";
import Button from "../ui/Button.astro";
import MobileMenu from "./MobileMenu.astro";

const navLinks = [
  { label: "Catálogo", href: "#catalogo" },
  { label: "Marcas", href: "#marcas" },
  { label: "Autenticidad", href: "#autenticidad" },
  { label: "Ubicación", href: "#ubicacion" }
];

const ctaUrl = buildWhatsappUrl("Hola Cronos Relojería, me gustaría consultar por disponibilidad y asesoría.");
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-40 transition-all duration-300 bg-transparent border-b border-transparent"
>
  <div class="max-w-6xl mx-auto px-5 sm:px-8 h-20 flex items-center justify-between">
    <!-- Brand Wordmark Logo -->
    <a
      href="/"
      class="flex items-center gap-2 group focus-visible:outline-2 focus-visible:outline-gold focus-visible:outline-offset-2 py-1"
      aria-label="Cronos Relojería - Inicio"
    >
      <span class="w-6 h-6 rounded-full border border-gold flex items-center justify-center text-[10px] text-gold font-serif group-hover:bg-gold group-hover:text-ink transition-colors duration-200">
        C
      </span>
      <span class="font-serif text-xl sm:text-2xl tracking-wider text-text uppercase font-semibold">
        Cronos<span class="text-gold font-light ml-1 text-sm tracking-widest lowercase">relojería</span>
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm text-muted hover:text-text tracking-wide transition-colors duration-200 relative py-1 focus-visible:outline-2 focus-visible:outline-gold focus-visible:outline-offset-2"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop CTA & Mobile Toggle Trigger -->
    <div class="flex items-center gap-4">
      <div class="hidden sm:block">
        <Button href={ctaUrl} target="_blank" size="sm" variant="primary">
          Escribinos
        </Button>
      </div>

      <!-- Mobile Menu Toggle Button (handled inside MobileMenu component) -->
      <button
        type="button"
        id="mobile-menu-open-btn"
        class="md:hidden flex flex-col justify-center items-center w-11 h-11 rounded border border-line text-text hover:border-gold/50 focus-visible:outline-2 focus-visible:outline-gold cursor-pointer"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-navigation-menu"
      >
        <span class="w-5 h-0.5 bg-text mb-1.5 transition-transform" aria-hidden="true"></span>
        <span class="w-5 h-0.5 bg-text mb-1.5 transition-opacity" aria-hidden="true"></span>
        <span class="w-3.5 h-0.5 bg-gold self-start ml-3 transition-transform" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Fullscreen Navigation Dialog/Panel -->
  <MobileMenu navLinks={navLinks} ctaUrl={ctaUrl} />
</header>

<!-- Header Scroll Behavior Script -->
<script>
  const initHeaderScroll = () => {
    const header = document.getElementById("site-header");
    if (!header) return;

    const handleScroll = () => {
      if (window.scrollY > 50) {
        header.classList.add("bg-ink/85", "backdrop-blur-md", "border-line", "shadow-sm");
        header.classList.remove("bg-transparent", "border-transparent");
      } else {
        header.classList.remove("bg-ink/85", "backdrop-blur-md", "border-line", "shadow-sm");
        header.classList.add("bg-transparent", "border-transparent");
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeaderScroll);
  } else {
    initHeaderScroll();
  }
</script>
