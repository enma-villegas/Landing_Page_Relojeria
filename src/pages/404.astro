---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Button from "../components/ui/Button.astro";
import WhatsappFab from "../components/ui/WhatsappFab.astro";
---

<BaseLayout
  title="Página no encontrada | Cronos Relojería"
  description="La página a la que intenta acceder no existe o fue trasladada. Regrese a la colección principal de Cronos Relojería."
>
  <Header />

  <main
    id="contenido"
    class="flex-1 flex flex-col items-center justify-center min-h-[70vh] px-5 sm:px-8 text-center pt-24 pb-16"
  >
    <div class="reveal max-w-lg mx-auto flex flex-col items-center">
      <!-- 404 Visual Monogram -->
      <span
        class="w-16 h-16 rounded-full border border-gold/40 bg-surface flex items-center justify-center text-xl font-serif text-gold mb-6 select-none"
        aria-hidden="true"
      >
        404
      </span>

      <span class="text-xs uppercase tracking-[0.25em] text-gold font-medium mb-3 select-none">
        Error de navegación
      </span>

      <h1 class="text-3xl sm:text-5xl font-serif text-text tracking-tight mb-4 font-semibold">
        Esta página se detuvo en el tiempo
      </h1>

      <p class="text-muted text-sm sm:text-base leading-relaxed mb-8 max-w-md font-sans">
        La dirección que busca no está disponible o ha cambiado de ubicación. Lo invitamos a explorar nuestra colección exclusiva de alta relojería.
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
        <Button href="/" variant="primary" size="md" class="w-full sm:w-auto">
          Volver al inicio
        </Button>
        <Button href="/#catalogo" variant="secondary" size="md" class="w-full sm:w-auto">
          Ver catálogo
        </Button>
      </div>
    </div>
  </main>

  <Footer />
  <WhatsappFab />
</BaseLayout>
